// restshimd sample configuration (ADR-0100).
//
// JSON has no comment syntax - restshimd's own parser will reject this
// file as-is. Copy it to /usr/local/etc/apiary/restshimd.json and
// remove comment-only and blank lines first (see docs/create-node.md).
// Every comment here stands on its own line and never trails a value.
// Every field below is present with either
// a realistic default or an empty value you may fill in - not
// commented out - so the stripped result is a complete, valid config.
//
// restshimd has no static process-wide manager API key of its own -
// every external caller presents its own bearer key, which every REST
// handler forwards unchanged to managerd. There is no field for that
// here; it travels in each request's own Authorization header.
{
  // TCP address of managerd's external RPC API. Must match this
  // node's own managerd.json rpc_addr exactly, hostname and all
  // (ADR-0139) - 127.0.0.1 does not work once rpc_addr names the
  // node's own DNS name, because such a listener deliberately does
  // not serve loopback. The hostname is also the only host managerd's
  // certificate carries a matching DNS SAN for; manager_tls_ca only
  // establishes trust in the certificate, not which name it must
  // match.
  "manager_addr": "<this-node-hostname>:17700",

  // Address to serve the REST API on. 127.0.0.1, not 0.0.0.0, and
  // that matches internal/restshimdconfig's own built-in default.
  // Nothing inside the Colony ever dials restshimd - the web UI has
  // its own conversion path, and raftd, managerd and apiaryinstall
  // never call it - so its only intended clients are external
  // tooling: curl, CI, a future provider. It is a full read/write
  // control API (create/update/delete/migrate/ISO-upload across VMs,
  // jails and networks) with no authentication of its own; it just
  // forwards each caller's own Authorization header to managerd, so
  // its entire security boundary is managerd's per-key auth. Remote
  // callers use an SSH local forward, e.g.
  //   ssh -L 8081:127.0.0.1:8081 <node>
  // Exposing this on the LAN is only worth considering once real
  // managerd API keys exist - before then the Authorization header is
  // decorative and the port is an unauthenticated control surface.
  // The port is fixed (ADR-0108).
  "http_addr": "127.0.0.1:8081",

  // Dial managerd over TLS instead of plaintext. managerd always
  // serves TLS by default now (see managerd.json.sample's own
  // tls_cert/tls_key) - leave this true unless managerd was
  // specifically reconfigured without TLS.
  "manager_tls": true,

  // PEM CA file to trust for managerd's certificate; empty trusts the
  // system pool. Points at the same self-signed certificate Step 6's
  // "make setup"/setup-tls generated.
  "manager_tls_ca": "/usr/local/etc/apiary-tls/cert.pem",

  // Hostname to verify managerd's certificate against, if different
  // from manager_addr's own host.
  "manager_tls_server_name": "",

  // Serve the REST API over HTTPS using Step 6's
  // "make setup"/setup-tls output by default.
  "tls_cert": "/usr/local/etc/apiary-tls/cert.pem",
  "tls_key": "/usr/local/etc/apiary-tls/key.pem"
}
