{
  "node_id": "<this-node-id>",
  "rpc_addr": "<this-node-hostname>:17700",
  "raftd_socket": "/var/run/apiary/raftd.sock",
  "uplink": "<uplink-ifname>",
  "nat_uplink": "",
  "dhcp_dns_server": "",
  "zfs_base": "<your-pool-name>/apiary",
  "reconcile_interval": 0,
  "bhyve_prefix": "",
  "bhyve_bootrom": "/usr/local/share/uefi-firmware/BHYVE_UEFI.fd",
  "bhyve_bridge": "bridge0",
  "allow_uplink_bridging": "",
  "disk_size_mb": 0,
  "iso_dir": "/var/db/apiary/isos",
  "hast_enabled": false,
  "jail_enabled": false,
  "jail_prefix": "",
  "jail_mount_base": "",
  "jail_disk_size_mb": 0,
  "peer_api_key": "",
  "peer_managerd_port": "17700",
  "peer_tls": false,
  "peer_tls_hostname_map": "",
  "peer_tls_ca": "",
  "known_peer_addresses": "",
  "assumption_check_interval": 0,
  "assumption_heartbeat_interval": 0,
  "assumption_stale_after": 0,
  "assumption_run_deadline": 0,
  "assumption_history_limit": 0,
  "assumption_history_max_age": 0,
  "tls_cert": "/usr/local/etc/apiary-tls/cert.pem",
  "tls_key": "/usr/local/etc/apiary-tls/key.pem",
  "pam_service": "",
  "cloudflare_token_file": "",
  "cloudflare_zone_id": "",
  "cloudflare_tunnel_id": "",
  "cloudflare_tunnel_credentials_file": "",
  "origin_ca_token_file": "",
  "origin_ca_directory": "",
  "origin_ca_renewal_check_interval": 0,
  "raftd_token": ""
}
